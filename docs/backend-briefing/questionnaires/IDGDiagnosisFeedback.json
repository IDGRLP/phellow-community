        },
        {
          "valueCoding": {
            "code": "incorrectAndIncomplete",
            "display": "Nein, die angezeigten Informationen sind (teilweise) fehlerhaft und unvollständig (falsch und unvollständig)"
          }
        },
        {
          "valueCoding": {
            "code": "correctButUnclearIfComplete",
            "display": "Die angezeigten Informationen sind korrekt, aber ich weiß nicht, ob noch etwas fehlt (richtig, aber unklar, ob vollständig)"
          }
        },
        {
          "valueCoding": {
            "code": "unknown",
            "display": "Ich weiß nicht, ob die anzeigten Informationen korrekt sind und ob noch Informationen fehlen (Richtigkeit und Vollständigkeit unklar)"
