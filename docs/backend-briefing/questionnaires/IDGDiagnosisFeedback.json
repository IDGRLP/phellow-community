      "text": "Stimmen die Diagnosedaten?",
      "required": true,
      "type": "choice",
      "answerOption": [
        {
          "valueCoding": {
            "code": "correctAndComplete",
            "display": "Ja, die angezeigten Informationen sind korrekt und vollständig (richtig und vollständig)"
          }
        },
        {
          "valueCoding": {
            "code": "correctButIncomplete",
            "display": "Ja, die angezeigten Informationen sind korrekt, aber es fehlt etwas (richtig, aber unvollständig)"
          }
        },
        {
          "valueCoding": {
            "code": "incorrectButComplete",
            "display": "Nein, die angezeigten Informationen sind (teilweise) fehlerhaft, aber an sich vollständig (falsch, aber vollständig)"
